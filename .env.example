VITE_API_URL=http://localhost:3001/api
VITE_LOG_API_CALLS=false

# Rows sent per CSV-import request. Defaults to 20, capped at the API's 40.
# Smaller fills the review list in smaller, more frequent steps; larger makes
# fewer round trips. Anything unparseable falls back to the default.
VITE_IMPORT_ROWS_PER_REQUEST=20

# Photo import (scan a bookshelf photo). Off by default: it requires a CORS rule
# on the S3 upload bucket allowing browser POSTs from this origin, or every
# upload fails silently. See LOS-164 and bookhunt/infra/s3-cors.json.
VITE_ENABLE_PHOTO_IMPORT=false
