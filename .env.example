# --- Browser (VITE_*, inlined at build time) ---

# Where the SPA reaches the BFF. A path, not an absolute URL: the BFF is served
# from the same origin as the app, which is what lets the session cookie be
# SameSite and keeps the browser from making a cross-origin request at all.
VITE_BFF_URL=/bff
VITE_LOG_API_CALLS=false

# Rows sent per CSV-import request. Defaults to 20, capped at the API's 40.
# Smaller fills the review list in smaller, more frequent steps; larger makes
# fewer round trips. Anything unparseable falls back to the default.
VITE_IMPORT_ROWS_PER_REQUEST=20

# Photo import (scan a bookshelf photo). Off by default: it requires a CORS rule
# on the S3 upload bucket allowing browser POSTs from this origin, or every
# upload fails silently. See LOS-164 and bookhunt/infra/s3-cors.json.
VITE_ENABLE_PHOTO_IMPORT=false

# --- BFF (server/, never reaches the browser) ---

PORT=3002
# The bookhunt API, reached server-to-server. Defaults to the API's own dev port.
API_BASE_URL=http://localhost:3001/api
# The origin the app is served from, used by the CSRF guard to recognise its own
# requests. In dev that is the Vite dev server, which proxies /bff to PORT.
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=bh_session
# Number of reverse proxies in front of the BFF, so req.ip is the reader's
# address and not the proxy's. Leave unset when nothing sits in front of it --
# trusting a forwarded header nobody is setting would let clients forge it.
TRUSTED_PROXY_HOPS=
